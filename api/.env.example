# Copier en api/.env pour le poste de développement (jamais de vraie valeur ici, règle S-2).
# Base de compose.dev.yml : l'API et le worker avec leurs rôles, les migrations en propriétaire.
GETEMALL_DATABASE_URL=postgresql+psycopg://getemall_app:fictif-app@localhost:5433/getemall
GETEMALL_WORKER_DATABASE_URL=postgresql+psycopg://getemall_worker:fictif-worker@localhost:5433/getemall
GETEMALL_MIGRATE_DATABASE_URL=postgresql+psycopg://getemall_owner:fictif-owner@localhost:5433/getemall
GETEMALL_CORS_ORIGINS=["http://localhost:8081"]
